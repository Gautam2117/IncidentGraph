# IncidentGraph Platform Configuration Blueprint

# Environment
ENVIRONMENT=development
GIT_SHA=unknown
LOG_LEVEL=INFO
DEBUG=true

# FastAPI Control Plane
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-in-production-incidentgraph-secret-key-32bytes
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=incidentgraph
POSTGRES_PASSWORD=incidentgraph_secret
POSTGRES_DB=incidentgraph_db
DATABASE_URL=postgresql+asyncpg://incidentgraph:incidentgraph_secret@localhost:5432/incidentgraph_db

# Redis & Async Tasks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
WEBHOOK_SIGNING_SECRET=replace-with-a-random-webhook-signing-secret
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-grafana-admin-password
BOOTSTRAP_ADMIN_EMAIL=admin@incidentgraph.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-random-admin-password-at-least-16-characters
BOOTSTRAP_ADMIN_FULL_NAME=IncidentGraph Administrator

# AI / Provider Settings
PRIMARY_LLM_PROVIDER=openai
ENABLE_OFFLINE_MODEL_ADAPTER=false
OPENAI_API_KEY=mock-key-or-set-your-key
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
LLM_FALLBACK_PROVIDER=none
# Local embeddings make the canonical Docker/Kubernetes stack self-contained.
# Set to openai/text-embedding-3-small when a real key is available.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DOCKER_EMBEDDING_PROVIDER=local
DOCKER_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Telemetry & OpenTelemetry Collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=control-plane
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
