FROM python:3.12-slim

ARG GIT_SHA=unknown

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/app \
    XDG_CACHE_HOME=/app/.cache \
    HF_HOME=/app/.cache/huggingface
ENV GIT_SHA=${GIT_SHA}

COPY pyproject.toml .
COPY services/control-plane /app/services/control-plane
COPY scripts /app/scripts
COPY README.md .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir --no-compile ".[local]" \
    && addgroup --system incidentgraph \
    && adduser --system --ingroup incidentgraph incidentgraph \
    && mkdir -p /app/.cache/huggingface \
    && chown -R incidentgraph:incidentgraph /app

ENV PYTHONPATH=/app/services/control-plane:.

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/live', timeout=4)"

USER incidentgraph

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
