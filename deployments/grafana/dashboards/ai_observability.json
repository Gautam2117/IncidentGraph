{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "LLM Token Consumption Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(incidentgraph_ai_tokens_total[5m])",
          "legendFormat": "{{provider}} - {{token_type}}"
        }
      ]
    },
    {
      "title": "Cumulative LLM Cost (USD)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(incidentgraph_ai_cost_usd_total)",
          "legendFormat": "Total Cost ($)"
        }
      ]
    },
    {
      "title": "Tool Execution Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(incidentgraph_tool_execution_seconds_bucket[5m])) by (le, tool_name))",
          "legendFormat": "{{tool_name}} (p95)"
        }
      ]
    },
    {
      "title": "Tool Execution Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(incidentgraph_tool_errors_total[5m])",
          "legendFormat": "{{tool_name}} errors"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ai", "llm", "observability", "incidentgraph"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "IncidentGraph - AI Observability & Performance",
  "uid": "ai_observability_dashboard"
}
